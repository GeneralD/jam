{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "jam",
  "version": "0.1.0",
  "displayName": "jam",
  "description": "Junction for AI Messaging: let Claude Code sessions in different repositories spawn each other, find each other, and pass prompts and results.",
  "author": {
    "name": "GeneralD",
    "url": "https://github.com/GeneralD"
  },
  "homepage": "https://github.com/GeneralD/jam",
  "repository": "https://github.com/GeneralD/jam",
  "license": "MIT",
  "keywords": ["multi-session", "orchestration", "messaging", "background-sessions"],
  "mcpServers": {
    "jam": {
      "command": "python3",
      "args": ["-I", "${CLAUDE_PLUGIN_ROOT}/scripts/jam", "mcp"]
    }
  }
}
